# Local display / online control-plane mode.
# Copy DISPLAY_TOKEN into the gitignored `.env`; it must exactly match the
# hosted apps/server deployment. No PocketBase administrator credential or
# join-grant secret is needed on the venue computer in this mode.

DISPLAY_TOKEN=

# Public services (these are the launcher defaults).
# PUBLIC_SERVER_URL=https://smartphonocracy-server.enabler.space
# POCKETBASE_URL=https://smartphonocracy.enabler.space
# REALTIME_WS_URL=wss://smartphonocracy-websockets.enabler.space

# Local display/media edge (these are also the defaults).
# HYBRID_DISPLAY_HOST=127.0.0.1
# HYBRID_DISPLAY_PORT=3000
# MEDIA_DIR=content/media
# DISPLAY_DIST_DIR=apps/display/dist

# Safety escape hatch for diagnostics only. A live display should be built
# from the exact Git revision reported by the hosted core's /api/status.
# HYBRID_ALLOW_VERSION_MISMATCH=false
